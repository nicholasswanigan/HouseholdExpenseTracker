@inject ApiClient Api
@inject IJSRuntime Js

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">Expense history</h2>
    @if (!showForm)
    {
        <button class="btn btn-success" @onclick="() => OpenForm(null)">+ Add expense</button>
    }
</div>

@if (showForm)
{
    <ExpenseForm @key="formVersion" Household="Household" Existing="editing" OnSaved="Saved" OnCancel="() => showForm = false" />
}

<div class="row g-2 mb-3">
    <div class="col-sm-4">
        <label class="form-label small mb-0">Month</label>
        <div class="input-group">
            <input class="form-control" type="month" value="@month" @onchange="OnMonthChanged" />
            @if (!string.IsNullOrEmpty(month)) { <button class="btn btn-outline-secondary" @onclick="ClearMonth">Clear</button> }
        </div>
    </div>
    <div class="col-sm-4">
        <label class="form-label small mb-0">Category</label>
        <select class="form-select" @bind="category" @bind:after="Load">
            <option value="">All categories</option>
            @foreach (var c in Enum.GetValues<ExpenseCategory>()) { <option value="@c">@c</option> }
        </select>
    </div>
    <div class="col-sm-4">
        <label class="form-label small mb-0">Person (paid or shares)</label>
        <select class="form-select" @bind="personId" @bind:after="Load">
            <option value="">Everyone</option>
            @foreach (var m in Household.Members) { <option value="@m.UserId">@m.DisplayName</option> }
        </select>
    </div>
</div>

@if (expenses is null)
{
    @if (error is null) { <p class="text-muted">Loading...</p> }
}
else if (expenses.Count == 0)
{
    <p class="text-muted">No expenses match.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Date</th><th>Description</th><th>Category</th><th>Paid by</th><th>Split</th><th class="text-end">Amount</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var e in expenses)
            {
                <tr>
                    <td class="text-nowrap">@Fmt.Date(e.Date)</td>
                    <td>@e.Description</td>
                    <td><span class="badge bg-body-secondary text-body border">@e.Category</span></td>
                    <td>@e.PayerName</td>
                    <td class="small text-muted" title="@SplitDetail(e)">@e.SplitType, @e.Splits.Count @(e.Splits.Count == 1 ? "person" : "people")</td>
                    <td class="text-end fw-semibold">@Fmt.Money(e.Amount)</td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-link" @onclick="() => OpenForm(e)">Edit</button>
                        <button class="btn btn-sm btn-link text-danger" @onclick="() => Delete(e)">Delete</button>
                    </td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr><td colspan="5" class="text-end text-muted">Total (@expenses.Count)</td><td class="text-end fw-bold">@Fmt.Money(expenses.Sum(x => x.Amount))</td><td></td></tr>
            </tfoot>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public HouseholdDetailDto Household { get; set; } = default!;

    private List<ExpenseDto>? expenses;
    private string? month;
    private ExpenseCategory? category;
    private string? personId;
    private ExpenseDto? editing;
    private bool showForm;
    private int formVersion;
    private string? error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        error = null;
        try
        {
            expenses = await Api.GetExpensesAsync(Household.Id, month, category,
                string.IsNullOrEmpty(personId) ? null : personId);
        }
        catch (ApiException ex) { error = ex.Message; }
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        month = e.Value?.ToString(); // "yyyy-MM", or empty when cleared
        await Load();
    }

    private async Task ClearMonth()
    {
        month = null;
        await Load();
    }

    private void OpenForm(ExpenseDto? existing)
    {
        editing = existing;
        formVersion++;
        showForm = true;
    }

    private async Task Saved()
    {
        showForm = false;
        await Load();
    }

    private async Task Delete(ExpenseDto e)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"Delete \"{e.Description}\" ({Fmt.Money(e.Amount)})?")) return;
        try
        {
            await Api.DeleteExpenseAsync(Household.Id, e.Id);
            await Load();
        }
        catch (ApiException ex) { error = ex.Message; }
    }

    private static string SplitDetail(ExpenseDto e) =>
        string.Join(", ", e.Splits.Select(s => $"{s.DisplayName} {Fmt.Money(s.Amount)}"));
}
